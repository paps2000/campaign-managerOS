rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isThinky() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@thinkydigital[.]com');
    }

    // Hora local de CDMX. request.time es UTC; sin este ajuste, un envío
    // legítimo del 31 a las 7 de la noche ya sería "día 1" para el servidor
    // y la regla lo rechazaría justo en las horas de más prisa.
    // México no cambia horario desde 2022, así que UTC-6 es fijo.
    function mxNow() {
      return request.time - duration.value(6, 'h');
    }

    // 'YYYY-MM' del mes en curso, en hora local. Mismo formato que escribe
    // el cliente en thinky-peso.js.
    function mxPeriod() {
      return string(mxNow().year()) + '-'
           + (mxNow().month() < 10 ? '0' : '') + string(mxNow().month());
    }

    // La ventana de reparto: "hoy + 8 días cae en el mes siguiente" equivale a
    // estar en los últimos 8 días del mes. La ventana real es de 7; el día
    // extra es colchón para relojes desfasados, y de todos modos el cliente no
    // deja repartir fuera de los 7.
    function tpWindowOpen() {
      return (mxNow() + duration.value(8, 'd')).month() != mxNow().month();
    }

    // ── El saldo del mes, como documento ──
    // El tope de 10 al mes no se puede verificar contando entregas: una regla
    // de Firestore no cuenta documentos. Se verifica contra un doc de saldo por
    // persona y periodo, que TIENE que moverse en el mismo commit que la
    // entrega. El id lo fija la regla (uid + '_' + periodo), así que nadie
    // puede escribir el saldo de alguien más ni revivir el de un mes cerrado.
    function tpBalPath(ws) {
      return /databases/$(database)/documents/workspaces/$(ws)/thinkyPesoBalances/$(request.auth.uid + '_' + mxPeriod());
    }
    function tpSpentBefore(ws) {
      return exists(tpBalPath(ws)) ? get(tpBalPath(ws)).data.spent : 0;
    }
    function tpSpentAfter(ws) {
      return existsAfter(tpBalPath(ws)) ? getAfter(tpBalPath(ws)).data.spent : 0;
    }
    function tpTxPath(ws, tx) {
      return /databases/$(database)/documents/workspaces/$(ws)/thinkyPesos/$(tx);
    }

    // ── Área de quien pide ──
    // El área vive en el doc de `members`. Se lee con get(), que cuesta una
    // lectura por evaluación: sólo se usa en las reseñas de clientes, que se
    // consultan al abrir una ficha y no en cada pantalla.
    function miembroPath(ws) {
      return /databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid);
    }
    function esCuentasOAdmin(ws) {
      return exists(miembroPath(ws))
        && (get(miembroPath(ws)).data.area == 'Cuentas'
         || get(miembroPath(ws)).data.role == 'admin');
    }

    // ── Perfil de cada persona ──
    // `users/{uid}` es la copia autoritativa: de ahí sale currentUserProfile al
    // entrar, y con ella el rol. Sólo se podía escribir el propio documento, así
    // que cuando un admin cambiaba área, puesto o rol desde Equipo la escritura
    // se rechazaba: la app mostraba "no tienes permiso", el cambio quedaba a
    // medias en `members` y —lo importante— al siguiente login del interesado el
    // arranque volvía a copiar el rol viejo de `users` sobre `members`.
    // Nombrar a alguien admin, en la práctica, no funcionaba.
    // El admin se comprueba contra su propio doc de `members` del workspace
    // 'default' (el único que existe; WORKSPACE en js/core.js).
    function esAdminWorkspace() {
      return exists(/databases/$(database)/documents/workspaces/default/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/workspaces/default/members/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Quién puede nombrar admins ──
    // El rol es el único campo del perfil que reparte permisos: esAdminWorkspace()
    // lo lee de `members`, y con él se gana escritura sobre el perfil de
    // cualquier otra persona (match /users/{uid}, abajo). Así que el rol no lo
    // cambia su propio dueño: o lo mueve un admin, o no se mueve.
    //
    // La excepción es el primer admin, y no es un capricho: la app lo siembra
    // desde el navegador en el primer login (INITIAL_ADMINS en js/core.js, se
    // usa en js/auth.js). Sin excepción, un workspace nuevo —o el borrado
    // accidental de ese perfil— se queda sin nadie que pueda nombrar
    // administradores, y hay que destrabarlo a mano desde la consola de
    // Firebase. La lista se repite aquí a propósito, con el mismo valor que el
    // código: si cambia el primer admin, hay que cambiar los dos lugares.
    function esAdminInicial() {
      return request.auth.token.email.lower() == 'paulo@thinkydigital.com';
    }

    // El rol que quedaría después de escribir, y el que hay ahora. En los dos
    // casos, 'member' cuando no hay campo: en un create no existe doc previo, y
    // un perfil viejo puede no traer `role` — leerlo sin más reventaría la
    // evaluación y la escritura se rechazaría sin que nadie entienda por qué.
    function rolNuevo() {
      return 'role' in request.resource.data ? request.resource.data.role : 'member';
    }
    function rolViejo() {
      return resource != null && 'role' in resource.data ? resource.data.role : 'member';
    }

    // Escribir tu propio perfil está bien; ascenderte, no. Ojo: reescribir el
    // MISMO rol sí tiene que pasar. El arranque copia el perfil de `users` a
    // `members` en cada login, rol incluido (js/auth.js), y ese set no está
    // dentro de un try: si la regla lo rechazara, no entraría nadie.
    function sinAscenderse() {
      return rolNuevo() == rolViejo() || esAdminInicial();
    }

    match /users/{uid} {
      allow read: if isThinky();

      // Antes esto era `write`, y bastaba con ser el dueño del doc. Como el
      // arranque copia este rol a `members` —que es de donde esAdminWorkspace()
      // lo saca—, ponerse 'admin' aquí y recargar la página alcanzaba para ser
      // admin de verdad, sin pasar nunca por `members`. Ahora el rol lo mueve
      // un admin; el resto del perfil, su dueño, como siempre.
      allow create, update: if isThinky()
        && (esAdminWorkspace() || (request.auth.uid == uid && sinAscenderse()));

      // El borrado queda como estaba (Equipo borra perfiles, y cada quien
      // podía borrar el propio). Va aparte porque en un delete no hay
      // `request.resource` y sinAscenderse() no se puede evaluar.
      allow delete: if isThinky() && (request.auth.uid == uid || esAdminWorkspace());
    }

    // El documento del workspace en sí.
    match /workspaces/{ws} {
      allow read, write: if isThinky();
    }

    // Todas las subcolecciones del workspace MENOS las del ThinkyPeso.
    // Ojo: las reglas de Firestore se SUMAN, no se pisan por especificidad.
    // Si este bloque dejara escribir thinkyPesos o thinkyPesoBalances, las
    // reglas estrictas de abajo no servirían de nada — el saldo sería
    // editable a mano y el tope mensual, decorativo.
    // Se usa {coll}/{doc=**} en vez de {document=**} para poder nombrar la
    // colección sin tener que enumerar las demás (campaigns, members, config,
    // creators, escenarios, notifications, creatorPrivateInfo, globalTasks,
    // influencerRatings… y las que vengan).
    match /workspaces/{ws}/{coll}/{doc=**} {
      // `clientNotes` y `thinkyPesos` se excluyen también de la LECTURA, no
      // sólo de la escritura. En los dos casos leer YA es el problema: las
      // reseñas hablan de personas del cliente, y una entrega de ThinkyPeso
      // lleva un mensaje privado y un monto que nadie más tiene por qué
      // comparar. Si este bloque las dejara leer, las reglas de abajo no
      // servirían de nada — las reglas se SUMAN, no se pisan.
      allow read: if isThinky() && coll != 'clientNotes' && coll != 'thinkyPesos';
      allow write: if isThinky()
        && coll != 'thinkyPesos'
        && coll != 'thinkyPesoBalances'
        && coll != 'clientNotes'
        // `members` sale del write por lo mismo, y es el caso más caro de los
        // cuatro: de ahí lee esAdminWorkspace(). Mientras estuvo aquí,
        // cualquier cuenta del dominio podía escribir su propio doc de
        // `members` y quedar admin. La LECTURA se queda arriba a propósito: la
        // app necesita leer `members` para armar el Equipo y saber áreas, y sin
        // eso no arranca.
        && coll != 'members';
    }

    // ── El perfil visible del equipo ──
    // Espejo de `users` que sí lee todo el workspace: de aquí sale allUsers, y
    // con él el Equipo, la credencial de los demás y el selector de personas.
    //
    // Área y puesto se los sigue poniendo cada quien: los elige en el
    // onboarding (obFinish, js/app.js) y el área también en la pantalla de
    // login. Es como está pensada la app hoy y no se cambia acá. Queda dicho
    // que `area == 'Cuentas'` abre las reseñas de clientes (esCuentasOAdmin):
    // si eso tiene que dejar de ser autoservicio, es una decisión de producto,
    // no un arreglo de reglas.
    match /workspaces/{ws}/members/{uid} {
      allow create, update: if isThinky()
        && (esAdminWorkspace() || (request.auth.uid == uid && sinAscenderse()));

      // Borrar un perfil del equipo es lo que hace Equipo (confirmDeleteUser,
      // js/equipo.js), y ya pedía admin del lado de la app. Aparte del bloque
      // de arriba por lo mismo: en un delete no hay `request.resource`.
      allow delete: if isThinky() && (request.auth.uid == uid || esAdminWorkspace());
    }

    // ── Reseñas de clientes ──
    // Qué se siente trabajar con una persona del cliente. Lo escribe y lo lee
    // Cuentas, que es quien mantiene la relación; el resto del equipo ve el
    // directorio de clientes pero no esto.
    //
    // Cada reseña son dos cosas: una calificación de 0.5 a 5 (en medias) y el
    // porqué escrito.
    // Las dos obligatorias — un número sin explicación no dice qué hacer
    // distinto, y un texto sin número no se puede comparar entre personas.
    //
    // No se editan ni se borran a propósito: una reseña es lo que alguien
    // pensó en una fecha, y reescribirla después borra el rastro de por qué se
    // decidió lo que se decidió. Tampoco se puede firmar con el nombre de otro.
    match /workspaces/{ws}/clientNotes/{nota} {
      allow read:   if isThinky() && esCuentasOAdmin(ws);
      allow create: if isThinky() && esCuentasOAdmin(ws)
                    && request.resource.data.autorUid == request.auth.uid
                    && request.resource.data.clientId is string
                    // Medias estrellas: 0.5 a 5 en pasos de media. `is number`
                    // acepta entero y decimal, así que las reseñas que ya
                    // existen con un 4 entero siguen siendo válidas. El paso se
                    // comprueba además del rango: un 3.7 escrito a mano rompe
                    // la escala común y deja de poder compararse.
                    && request.resource.data.estrellas is number
                    && request.resource.data.estrellas >= 0.5
                    && request.resource.data.estrellas <= 5
                    && request.resource.data.estrellas * 2 == math.floor(request.resource.data.estrellas * 2)
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() >= 10
                    && request.resource.data.texto.size() <= 4000;
      allow update, delete: if false;
    }

    // ── Saldo del mes ──
    // spent = cuántos ThinkyPesos lleva repartidos esta persona este periodo.
    // Nunca pasa de 10, y ahí queda cerrado el tope mensual: como ninguna
    // entrega se puede crear sin subir este número, el total del mes no puede
    // superar 10 por más veces que se intente.
    match /workspaces/{ws}/thinkyPesoBalances/{bal} {
      // Solo tu propio contador: dice cuánto repartiste este mes y nadie más
      // tiene por qué llevar esa cuenta. El id es 'uid_periodo', así que
      // comparar contra el uid basta.
      // `resource == null` va primero: el primer envío del mes lee un doc que
      // todavía no existe (tpSend consulta el contador antes de escribirlo), y
      // sin esta salida la evaluación reventaría y el envío moriría con
      // "permission denied" justo en la primera entrega.
      allow read: if isThinky()
        && (resource == null || resource.data.uid == request.auth.uid);

      // No se borra. Si se pudiera, borrarlo sería resetear el saldo del mes.
      allow delete: if false;

      allow create, update: if isThinky()
        // el id manda: solo tu saldo, solo del mes en curso
        && bal == request.auth.uid + '_' + mxPeriod()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.period == mxPeriod()
        && request.resource.data.spent is int
        && request.resource.data.spent >= 0
        && request.resource.data.spent <= 10
        && (
          // SUBIR: solo dentro de la ventana de reparto.
          (request.resource.data.spent >= (resource == null ? 0 : resource.data.spent)
             && tpWindowOpen())
          ||
          // BAJAR: solo emparejado con el borrado de la entrega que nombra
          // `undoTx`, y nunca devolviendo más de lo que esa entrega valía.
          // `resource != null` va primero porque en un create no hay doc
          // previo y leer resource.data reventaría la evaluación; el
          // `.size() > 0` porque un undoTx vacío armaría una ruta con un
          // segmento en blanco (tpSend escribe undoTx:'' justamente).
          (resource != null
             && request.resource.data.undoTx is string
             && request.resource.data.undoTx.size() > 0
             && exists(tpTxPath(ws, request.resource.data.undoTx))
             && !existsAfter(tpTxPath(ws, request.resource.data.undoTx))
             && get(tpTxPath(ws, request.resource.data.undoTx)).data.fromUid == request.auth.uid
             && get(tpTxPath(ws, request.resource.data.undoTx)).data.period == mxPeriod()
             && request.resource.data.spent >=
                  resource.data.spent - get(tpTxPath(ws, request.resource.data.undoTx)).data.amount)
        );
    }

    // ── Entregas ──
    // Una entrega por documento. Inmutable una vez escrita.
    match /workspaces/{ws}/thinkyPesos/{tx} {
      // Una entrega es cosa de dos: solo la leen quien la dio y quien la
      // recibió. Así nadie puede ver el motivo ajeno ni sumar cuánto lleva
      // recibido otra persona — ni desde la consola del navegador.
      //
      // Esto obliga al cliente a consultar con filtro: Firestore evalúa una
      // consulta contra la regla y rechaza ENTERA la que pueda devolver
      // documentos negados. Por eso js/core.js escucha dos consultas
      // (where fromUid == yo, where toUid == yo) en vez de la colección.
      allow read: if isThinky()
        && (resource.data.fromUid == request.auth.uid
         || resource.data.toUid == request.auth.uid);

      allow create: if isThinky()
        // no puedes dar a nombre de alguien más
        && request.resource.data.fromUid == request.auth.uid
        // ni darte a ti mismo
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        // montos sanos
        && request.resource.data.amount is int
        && request.resource.data.amount >= 1
        && request.resource.data.amount <= 10
        // ninguna moneda viaja sin motivo
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 12
        && request.resource.data.reason.size() <= 280
        // el periodo no se puede falsear para revivir un mes cerrado
        && request.resource.data.period == mxPeriod()
        // y solo dentro de la ventana
        && tpWindowOpen()
        // el saldo del mes sube al menos lo que vale esta entrega, en este
        // mismo commit. Como el saldo tiene techo de 10, esto cierra el tope:
        // no hay forma de entregar sin pagarlo contra el contador.
        && tpSpentAfter(ws) >= tpSpentBefore(ws) + request.resource.data.amount;

      // Una entrega no se edita: se deshace y se vuelve a hacer.
      allow update: if false;

      // Deshacer solo lo tuyo, solo del mes en curso, y solo si el saldo del
      // mismo commit reconoce la devolución nombrando esta entrega.
      allow delete: if isThinky()
        && resource.data.fromUid == request.auth.uid
        && resource.data.period == mxPeriod()
        && existsAfter(tpBalPath(ws))
        && getAfter(tpBalPath(ws)).data.undoTx == tx;
    }

    match /clientShares/{token} {
      // Lectura pública por token: es la vista de cliente. `list` sigue cerrado
      // para que nadie pueda enumerar los tokens existentes.
      allow get: if true;
      allow list: if false;
      // `request.auth != null` dejaba escribir a CUALQUIER cuenta de Google que
      // se autenticara contra este proyecto, aunque la app la rechace después
      // por dominio: el token de Firebase se emite igual. Publicar o pisar el
      // snapshot de un cliente es cosa del equipo.
      allow create, update, delete: if isThinky();
    }
  }
}
